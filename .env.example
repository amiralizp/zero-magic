# Copy to .env and never commit .env.
# The API works with no key: the offline mock provider is the default.

# Browser origin allowed by CORS. No wildcard.
FRONTEND_ORIGIN=http://localhost:5173

# Breakdown endpoint limits (weeks 3).
BREAKDOWN_TIMEOUT_SECONDS=15
BREAKDOWN_RATE_LIMIT=5
BREAKDOWN_RATE_WINDOW_SECONDS=60
MAX_PRD_CHARS=20000
MODEL_RETRIES=2

# mock-strong and mock-fast are always available and free.
MODEL_PRIMARY=mock-strong
MODEL_FALLBACK=mock-fast
DEFAULT_PROMPT_VERSION=v2

# Optional: a real OpenAI-compatible provider (OpenRouter by default).
# When both model names below are real model ids and the key is set,
# the same endpoint calls them instead of the mocks.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_MODEL_PRIMARY=openai/gpt-4o-mini
# OPENROUTER_MODEL_FALLBACK=google/gemini-2.0-flash-001
