# Copy to .env and never commit .env.
# The API works with no key: the offline mock provider is the default.

# Browser origin allowed by CORS. No wildcard.
FRONTEND_ORIGIN=http://localhost:5173

# Breakdown endpoint limits (weeks 3).
BREAKDOWN_TIMEOUT_SECONDS=15
BREAKDOWN_RATE_LIMIT=5
BREAKDOWN_RATE_WINDOW_SECONDS=60
MAX_PRD_CHARS=20000
MODEL_RETRIES=2

# mock-strong and mock-fast are always available and free.
MODEL_PRIMARY=mock-strong
MODEL_FALLBACK=mock-fast
DEFAULT_PROMPT_VERSION=v2

# Optional: a real OpenAI-compatible provider (OpenRouter by default).
# When both model names below are real model ids and the key is set,
# the same endpoint calls them instead of the mocks.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_MODEL_PRIMARY=openai/gpt-4o-mini
# OPENROUTER_MODEL_FALLBACK=google/gemini-2.0-flash-001

# SQL Server persistence. Leave DB_USER empty for the in-memory store
# (tests and a quick look at the API need no server).
# The app creates its tables on startup; the same rows are visible in SSMS.
DB_SERVER=localhost
DB_NAME=Gantry
DB_USER=
DB_PASSWORD=

# Backups are manual only: the console's Backup button or backup-db-now.bat.
# Old files are pruned only when a new backup is written.
BACKUP_KEEP_DAYS=14
BACKUP_DIR=backups

# AI Chat (the console's chat panel and /chat).
# DeepSeek by default; any OpenAI-compatible base URL works.
# Keys are created at https://platform.deepseek.com/api_keys and start with sk-.
CHAT_API_KEY=
CHAT_BASE_URL=https://api.deepseek.com
CHAT_MODEL=deepseek-flash
CHAT_PROVIDER=DeepSeek
# Only when the model list is not at $CHAT_BASE_URL/models, as with OpenCode Go.
# CHAT_MODELS_URL=https://opencode.ai/inference/go/v1/models
# OpenCode Go rejects a completion that omits this header.
# CHAT_SESSION=ses_gantry

# Outbound proxy for chat calls, if the network needs one. httpx reads these
# on its own; leave them commented for direct access.
# HTTPS_PROXY=http://127.0.0.1:7890
# HTTP_PROXY=http://127.0.0.1:7890
